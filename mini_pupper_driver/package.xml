<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mini_pupper_driver</name>
  <version>1.0.0</version>
  <description>Hardware driver package for Mini Pupper on ROS 2 Jazzy</description>
  <maintainer email="fae@mangdang.net">MangDang</maintainer>
  <license>Apache-2.0</license>

  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>rclpy</depend>
  
  <exec_depend>image_transport</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
