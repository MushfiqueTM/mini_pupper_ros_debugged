<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mini_pupper_simulation</name>
  <version>2.0.0</version>
  <description>Mini Pupper Simulation Package for ROS 2 Jazzy with Gazebo Harmonic</description>

  <maintainer email="fae@mangdang.net">MangDang</maintainer>
  <author email="thefoxfoxfox@outlook.com">Han</author>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>launch_ros</build_depend>

  <depend>rclcpp</depend>
  
  <!-- Gazebo Harmonic (gz) dependencies for Jazzy -->
  <exec_depend>ros_gz</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  
  <!-- Legacy Gazebo (classic) dependencies removed for Jazzy -->
  <!-- Use Gazebo Harmonic instead -->
  
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>ros2_control</exec_depend>

  <exec_depend>rviz2</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
